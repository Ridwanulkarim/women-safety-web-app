rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication and role verification
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // 1. Users collection rules (Per-user profile isolation)
    match /users/{userId} {
      // Users can only read their own profile unless requester is Admin
      allow read: if isOwner(userId) || isAdmin();
      
      // Users can create their initial profile with role defaulted to 'user'
      allow create: if isAuthenticated() 
        && request.auth.uid == userId
        && (!('role' in request.resource.data) || request.resource.data.role == 'user');
        
      // Users can update their own profile fields, but CANNOT elevate role or alter status
      allow update: if (isOwner(userId) 
        && request.resource.data.role == resource.data.role 
        && request.resource.data.status == resource.data.status) 
        || isAdmin();

      // Only Admins can delete user profiles
      allow delete: if isAdmin();
    }

    // 2. Contacts collection rules (Emergency contact privacy)
    match /contacts/{contactId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // 3. SOS collection rules (Distress beacon security)
    match /sos/{sosId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 4. Notifications collection rules
    match /notifications/{notificationId} {
      allow read, update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, delete: if isAdmin();
    }

    // 5. Audit Logs collection rules (Admin-only read, immutable by client SDKs)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Only Admin SDK (bypassing client security rules) writes audit entries
    }

    // 6. Public read collections (Announcements, Blogs, Safety Tips)
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /safetyTips/{tipId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
